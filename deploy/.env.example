# deploy/.env: production settings for compose.prod.yml and deploy.sh.
# Copy to deploy/.env on the VM, fill in, then `chmod 600 deploy/.env`.
# Never commit the filled-in file (deploy/.gitignore ignores it).
# Replace harvestfc.duckdns.org with your domain everywhere.

# --- Compose -----------------------------------------------------------------
# "duckdns" keeps DUCKDNS_DOMAIN pointed at this VM. Add ",tunnel" only for the
# older Cloudflare Tunnel setup (TUNNEL_TOKEN below).
COMPOSE_PROFILES=duckdns
APP_ENV=production

# --- Caddy (HTTPS, same origin) ----------------------------------------------------
# The public hostname. Caddy gets its certificate from Let's Encrypt over port 80.
DOMAIN=harvestfc.duckdns.org
# The static web app: releases/<version>/ plus a `current` symlink (deploy.sh web).
WEB_ROOT=./web
# Pinned compose network; Caddy's fixed address is the API's only trusted proxy.
# Change all three together, CADDY_IP inside MFP_SUBNET and outside MFP_IP_RANGE.
MFP_SUBNET=172.30.0.0/24
MFP_IP_RANGE=172.30.0.128/25
CADDY_IP=172.30.0.10

# --- DuckDNS -------------------------------------------------------------------
# duckdns.org > your account: the subdomain (without .duckdns.org) and the token.
DUCKDNS_DOMAIN=harvestfc
DUCKDNS_TOKEN=

# --- API image -----------------------------------------------------------------
# Built with `deploy.sh push` from a laptop.
# OWNER is your GitHub user, lowercase. Set API_IMAGE=myfantasyprem-api to use
# an image built on the VM with `deploy.sh build`. The tag in service lives in
# deploy/.release (written by deploy.sh), not here.
API_IMAGE=ghcr.io/OWNER/myfantasyprem-api

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=myfantasyprem
POSTGRES_DB=myfantasyprem
# URL-safe characters only (it goes into DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
PG_MAJOR=17

# --- Public URLs -------------------------------------------------------------
# The web app's public origin, no path: https://DOMAIN (Caddy serves both the
# app and the API). Magic links open APP_URL/sign-in?token=... and invite
# links APP_URL/join/CODE. Required: APP_ENV=production refuses to start without it.
APP_URL=https://harvestfc.duckdns.org
# Comma separated; also the WebSocket origin allow-list.
CORS_ALLOWED_ORIGINS=https://harvestfc.duckdns.org
# The realtime socket as clients reach it through Caddy.
REALTIME_URL=wss://harvestfc.duckdns.org/v1/realtime
# Over-the-air iOS updates (docs/IOS.md): set UPDATES_DIR=/var/lib/mfp/updates
# (the updates volume) to serve /updates; empty keeps it off.
UPDATES_DIR=
UPDATES_PUBLIC_URL=https://harvestfc.duckdns.org

# --- Cloudflare Tunnel (older setup, profile "tunnel") ------------------------------
# Zero Trust > Networks > Tunnels > your tunnel > the token in the docker command.
# Public hostname in the tunnel: api.example.com -> http://api:8080
TUNNEL_TOKEN=

# --- Stats poller --------------------------------------------------------------
POLLER_ENABLED=true
POLLER_SOURCE=fpl
# Keep a contact in it so upstream can reach you.
FPL_USER_AGENT="MyFantasyPrem-stats/1.0 (+mailto:you@example.com)"
# Scheduled read-only checks of imported leagues against FPL stop on this date
# (2027-01-01 or RFC 3339). Empty: they run all season.
FPL_SHADOW_UNTIL=
# League ids (lg_...) whose "Re-sync from FPL" answers 409 resync-disabled,
# comma separated. Empty: every imported league may re-sync.
FPL_RESYNC_DISABLED_LEAGUES=

# --- Branded images (docs/RUNBOOK.md) ------------------------------------------
# true: /v1/assets serves the official club crests, shirts and player photos
# (fetched once, cached). Private builds only: false for App Store and any
# other public build (Apple's intellectual-property guideline). Required.
BRANDED_ASSETS=true

# --- Web Push (docs/notifications.md) ------------------------------------------
# Browser push notifications. Make a pair once with `npm run admin -- vapid-keys`
# and never change it (that orphans every browser's subscription). All three or
# none; none leaves push off (the in-app inbox still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT is a contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# --- Email (magic links) -------------------------------------------------------
# resend | log | none. "log" prints sign-in links to the API log: production
# refuses it. none: no email sign-in (claim links and `deploy.sh admin session`
# sign people in). resend needs the two settings below.
EMAIL_PROVIDER=none
# Resend > API Keys > Create (permission: Sending access, domain: example.com)
RESEND_API_KEY=
# Must be on the domain verified in Resend.
EMAIL_FROM="MyFantasyPrem <login@example.com>"

# --- Claim links sign people in (testing phase, docs/adr/0013) -------------------
# true: a signed-out friend opening a seat's claim link enters a name and gets an
# account and the seat, no email. The API logs a warning at startup in production.
# Set false once email, Google or Apple sign-in works for the testers.
CLAIM_LINK_SIGNIN=true

# --- Native sign-in (optional; empty answers 503 sign-in-unavailable) ----------
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=

# --- Backups (Cloudflare R2, S3-compatible) -------------------------------------
# R2 > Overview: the S3 API endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2 > Manage API tokens > Create: "Object Read & Write", this bucket only.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=myfantasyprem-backups
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_PREFIX=postgres
BACKUP_RETENTION_DAYS=30
# Optional: a Healthchecks.io check URL (daily period, 2h grace); pinged after
# each good backup, and <url>/fail on failure.
BACKUP_HEARTBEAT_URL=

# --- Misc ------------------------------------------------------------------------
LOG_LEVEL=info
# Host ports on 127.0.0.1 (curl from the VM only).
API_HOST_PORT=8080
METRICS_HOST_PORT=9090
