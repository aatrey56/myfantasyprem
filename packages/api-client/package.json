{
  "name": "@myfantasyprem/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the MyFantasyPrem API, generated from api/openapi.yaml.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi.yaml -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
