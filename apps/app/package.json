{
  "name": "@myfantasyprem/app",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "web:mocks": "node scripts/copy-msw-worker.mjs public && EXPO_PUBLIC_USE_MOCKS=true expo start --web",
    "ios": "expo run:ios",
    "ios:mocks": "EXPO_PUBLIC_USE_MOCKS=true expo run:ios",
    "android": "expo run:android",
    "build:web": "node scripts/copy-msw-worker.mjs --remove public && expo export --platform web --clear --output-dir dist",
    "build:web:mocks": "EXPO_PUBLIC_USE_MOCKS=true expo export --platform web --clear --output-dir dist-mocks && node scripts/copy-msw-worker.mjs dist-mocks",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/jest.mjs",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.3",
    "@gorhom/bottom-sheet": "5.2.14",
    "@myfantasyprem/api-client": "0.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/query-sync-storage-persister": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "expo": "57.0.27",
    "expo-apple-authentication": "57.0.2",
    "expo-auth-session": "57.0.15",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.4",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-image": "57.0.5",
    "expo-linking": "57.0.12",
    "expo-network": "57.0.2",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-updates": "57.0.26",
    "expo-web-browser": "57.0.3",
    "lucide-react-native": "1.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "4.3.4",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/env": "2.4.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "msw": "3.0.2",
    "test-renderer": "1.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "workerIdleMemoryLimit": "800MB",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.after-env.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/dist-mocks/",
      "/dist-server/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|msw|@msw|@mswjs|@open-draft|until-async|rettime|headers-polyfill|outvariant|is-node-process|tough-cookie|cookie|lucide-react-native|decode-uri-component))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
