# Copy to .env.local (git-ignored) to override. Only EXPO_PUBLIC_* reach the app,
# and they are inlined at build time: read them as process.env.EXPO_PUBLIC_X.

# Base URL of the Go API. Leave unset for web builds served next to the API
# (same-origin). Required for native production builds (app.config.ts checks).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# "true" shows Expected points and win chances (hidden for now; ADR 0014).
# EXPO_PUBLIC_SHOW_PROJECTIONS=true

# "true" serves fake data from MSW (web only). Use npm run dev:web:mocks or
# build:web:mocks instead of setting it by hand.
# EXPO_PUBLIC_USE_MOCKS=true
